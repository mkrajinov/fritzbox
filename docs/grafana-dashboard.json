      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "online",
                  "color": "green",
                  "index": 1
                }
              }
